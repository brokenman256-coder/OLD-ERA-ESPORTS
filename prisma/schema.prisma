// Prisma schema for Vantix tournament platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Role: "PLAYER" | "ORGANIZER" | "ADMIN"
// ApprovalStatus: "PENDING" | "APPROVED" | "REJECTED"
// TournamentFormat: "SINGLE_ELIMINATION" | "DOUBLE_ELIMINATION" | "ROUND_ROBIN" | "SWISS" | "BATTLE_ROYALE"

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("PLAYER")
  firmName     String? // organizer's company / firm name
  phone        String?
  isBanned     Boolean  @default(false)

  avatarUrl     String?
  bio           String?
  discordHandle String?
  twitterUrl    String?
  websiteUrl    String?
  gmail         String? // linked Gmail / Google contact address, shown on the public profile
  isVerified    Boolean  @default(false) // verified-organizer / notable-player badge

  walletBalance Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tournaments        Tournament[]        @relation("OrganizerTournaments")
  registrations      Registration[]
  captainOfTeams     Team[]              @relation("TeamCaptain")
  teamMemberships    TeamMember[]
  supportMessages    SupportMessage[]
  playerMatches      PlayerMatch[]       @relation("PlayerMatchCreator")
  walletTransactions WalletTransaction[]
  walletTopUps       WalletTopUp[]
  withdrawalRequests WithdrawalRequest[]
}

model Team {
  id        String   @id @default(cuid())
  name      String
  tag       String? // short clan tag, e.g. "TSM"

  captainId String
  captain   User   @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       TeamMember[]
  registrations Registration[]
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
}

model Tournament {
  id          String         @id @default(cuid())
  title       String
  game        String
  description String
  rules       String?
  prizePool   String?
  entryFee    Float          @default(0)
  hostingFee  Float          @default(0)
  maxSlots    Int?
  startDate   DateTime
  endDate     DateTime?

  bannerUrl  String?
  tags       String? // comma-separated
  discordUrl String?
  streamUrl  String?
  format     String  @default("SINGLE_ELIMINATION")

  roomId       String? // custom-match room ID, shared with approved players before start
  roomPassword String?

  organizerId String
  organizer   User   @relation("OrganizerTournaments", fields: [organizerId], references: [id], onDelete: Cascade)

  status              String  @default("PENDING")
  reviewNote          String?
  hostingFeeProof     String? // path to payment screenshot for hosting fee
  hostingFeeVerified  Boolean @default(false)
  hostingFeePaidWithWallet Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations Registration[]
  matches       Match[]
}

model Registration {
  id           String @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  playerId String
  player   User   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  teamName      String? // free-text team/IGN label shown alongside the registration
  teamId        String? // optional link to a real Team roster
  team          Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  paymentProof  String? // path to payment screenshot for entry fee
  status        String  @default("PENDING")
  reviewNote    String?

  contactPhone  String? // mandatory contact number collected at registration
  squadMembers  Json?   // array of exactly 4 { name, gameId } entries
  resultProof   String? // screenshot of the match end result, submitted by the player after the match
  paidWithWallet Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchesAsP1 Match[] @relation("MatchReg1")
  matchesAsP2 Match[] @relation("MatchReg2")
  matchesWon  Match[] @relation("MatchWinner")

  @@unique([tournamentId, playerId])
}

// Bracket: "MAIN" (single elim / round robin) | "WB" | "LB" | "GRAND_FINAL" (double elim)
// MatchStatus: "PENDING" (waiting on a participant) | "READY" (both set, unplayed) | "COMPLETED"
model Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  bracket String @default("MAIN")
  round   Int
  slot    Int

  registration1Id String?
  registration1    Registration? @relation("MatchReg1", fields: [registration1Id], references: [id], onDelete: SetNull)
  registration2Id String?
  registration2    Registration? @relation("MatchReg2", fields: [registration2Id], references: [id], onDelete: SetNull)

  score1                Int?
  score2                Int?
  winnerRegistrationId  String?
  winnerRegistration    Registration? @relation("MatchWinner", fields: [winnerRegistrationId], references: [id], onDelete: SetNull)

  isBye  Boolean @default(false)
  status String  @default("PENDING")

  // structural links to the skeleton generated at bracket-creation time; not enforced FKs
  // so the skeleton can be built bottom-up without relation-ordering constraints
  nextMatchId        String?
  nextMatchSlot      Int?
  loserNextMatchId   String?
  loserNextMatchSlot Int?

  // double-elimination only: marks a losers-bracket slot as structurally unfillable
  // (its feeder winners-bracket match was a bye, so it produced no loser); lets a
  // real opponent auto-advance past it without waiting for a match that can never happen
  slot1Phantom Boolean @default(false)
  slot2Phantom Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, bracket, round, slot])
}

model SiteSettings {
  id               String   @id @default("global")
  hostingFeeAmount Float    @default(200)
  upiId            String? // organizer-facing UPI ID, for hosting fee payments
  qrCodeUrl        String? // organizer-facing payment QR code
  playerUpiId      String? // player-facing UPI ID, for entry fee payments
  playerQrCodeUrl  String? // player-facing payment QR code
  whatsappLink     String?
  instagramUrl     String?

  supportEmail   String?
  supportPhone   String?
  supportMessage String?

  // Optional overrides for the homepage stat counters. When null, the real
  // database count is shown instead.
  displayLiveTournaments Int?
  displayPlayers         Int?
  displayOrganizers      Int?

  // Automated tournament-creation bot
  botEnabled         Boolean   @default(false)
  botIntervalMinutes Int       @default(20)
  botLastRunAt       DateTime?

  updatedAt DateTime @updatedAt
}

model PromoBanner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SupportMessage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  body      String
  fromAdmin Boolean @default(false) // false = message from the user, true = reply from admin
  read      Boolean @default(false) // read by the recipient (the user, if fromAdmin; admin, if not)

  createdAt DateTime @default(now())

  @@index([userId])
}

model PlayerMatch {
  id          String @id @default(cuid())
  mode        String // "WOW" | "TDM"
  title       String
  description String?
  matchCode   String // room / WOW code other players use to join in-game
  entryFee    Float   @default(0)
  maxSlots    Int?
  startDate   DateTime

  creatorId String
  creator   User   @relation("PlayerMatchCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  status     String  @default("PENDING")
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// WalletTransaction.type: "TOPUP" | "WITHDRAWAL" | "WITHDRAWAL_REVERSAL"
//   | "ENTRY_FEE_PAYMENT" | "HOSTING_FEE_PAYMENT" | "ADMIN_CREDIT" | "ADMIN_DEBIT"
model WalletTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type         String
  amount       Float // signed: positive = credit, negative = debit
  balanceAfter Float
  note         String?

  createdAt DateTime @default(now())

  @@index([userId])
}

model WalletTopUp {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount     Float
  proof      String // payment screenshot uploaded by the user
  status     String  @default("PENDING")
  reviewNote String?

  createdAt DateTime @default(now())

  @@index([userId])
}

model WithdrawalRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount     Float
  payoutInfo String // UPI ID / bank details to send the payout to
  status     String  @default("PENDING") // PENDING | APPROVED | REJECTED | PAID
  reviewNote String?

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([userId])
}
