# PostgreSQL connection strings. In production these come from your Postgres
# provider (e.g. Neon via the Vercel integration). For local dev, point both
# at a local/dev Postgres database (DATABASE_URL_UNPOOLED can be the same value
# if you don't have a separate direct connection).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session JWTs. Generate your own with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# Seeded admin account (run `npm run db:seed` to create/update it)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-immediately"
ADMIN_NAME="Admin"

# Vercel Blob token for storing payment screenshots (from `vercel blob create-store`
# or the Storage tab in your Vercel project)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
